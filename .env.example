# Copy to .env (chmod 600) and fill in on the VM. Never commit .env.
# Placeholders only: real values are typed on the VM by you.

# Database password for the compose Postgres.
POSTGRES_PASSWORD=change-me

# Kite Connect app credentials (developers.kite.trade). The access token is not
# stored here: `docker compose run --rm login` fetches it each morning.
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret

# Telegram alerts (levels, P&L and counts only). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# age public key (age1...) that nightly backups are encrypted to. Keep the
# matching private key OFF this machine (see docs/runbook.md, Backups).
PMT_BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key

# Off-machine copy target for deploy/offsite.sh: rsync over Tailscale.
PMT_OFFSITE_DEST=backup-host:/srv/pmt-backups/

PMT_LOG_LEVEL=info
